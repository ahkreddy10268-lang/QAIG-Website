{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/CardAction/**",
              "components/general/CardContent/**",
              "components/general/CardDescription/**",
              "components/general/CardFooter/**",
              "components/general/CardHeader/**",
              "components/general/CardTitle/**",
              "components/general/Separator/**",
              "components/general/Tooltip/**",
              "components/general/TooltipContent/**",
              "components/general/TooltipProvider/**",
              "components/general/TooltipTrigger/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|asChild|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|success|warning|destructive|outline)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'success' | 'warning' | 'destructive' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|size|asChild|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, size, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|secondary|destructive|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'link' | 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon|icon-sm|icon-lg)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg' | 'icon' | 'icon-sm' | 'icon-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardAction> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardContent> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardDescription'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardDescription> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardFooter> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardHeader> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<CardTitle> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|decorative|style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, decorative, style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Separator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|delayDuration|disableHoverableContent|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: children, open, defaultOpen, delayDuration, disableHoverableContent."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:forceMount|style|className|id|children|asChild|side|sideOffset|align|alignOffset|arrowPadding|avoidCollisions|collisionBoundary|collisionPadding|sticky|hideWhenDetached|updatePositionStrategy|ref|key|ref|className|style|children)$/]",
        "message": "<TooltipContent> doesn't accept that prop. Declared props: forceMount, style, className, id, children, asChild, side, sideOffset, align, alignOffset, arrowPadding, avoidCollisions, collisionBoundary, collisionPadding, sticky, hideWhenDetached, updatePositionStrategy, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipContent'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|right|bottom|left)$/]",
        "message": "<TooltipContent> side must be one of 'top' | 'right' | 'bottom' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipContent'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start|end)$/]",
        "message": "<TooltipContent> align must be one of 'center' | 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipContent'] > JSXAttribute[name.name='sticky'] > Literal[value!=/^(?:partial|always)$/]",
        "message": "<TooltipContent> sticky must be one of 'partial' | 'always'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipContent'] > JSXAttribute[name.name='updatePositionStrategy'] > Literal[value!=/^(?:always|optimized)$/]",
        "message": "<TooltipContent> updatePositionStrategy must be one of 'always' | 'optimized'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipProvider'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|delayDuration|skipDelayDuration|disableHoverableContent|key|ref|className|style|children)$/]",
        "message": "<TooltipProvider> doesn't accept that prop. Declared props: children, delayDuration, skipDelayDuration, disableHoverableContent."
      },
      {
        "selector": "JSXOpeningElement[name.name='TooltipTrigger'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<TooltipTrigger> doesn't accept that prop. Declared props: style, className, id, children, asChild, ref."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
